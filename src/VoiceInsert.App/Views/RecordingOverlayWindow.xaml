<Window x:Class="VoiceInsert.App.Views.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="210" Height="76"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0.88"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Border Background="#F9F3E8" BorderBrush="#D6CFC3" BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText"
                       Text="Recording"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#293630" />
            <Canvas x:Name="WaveCanvas" Grid.Row="1" Height="30" Margin="0,7,0,0" ClipToBounds="True">
                <Line X1="0" Y1="15" X2="190" Y2="15" Stroke="#D3C8BA" StrokeThickness="1" StrokeDashArray="2 4" />
                <Polygon x:Name="AmplitudeFill" Fill="#7AAFA7" Opacity="0.32" />
                <Polyline x:Name="AmplitudeLine" Stroke="#7AAFA7" StrokeThickness="2" StrokeLineJoin="Round" />
                <Polyline x:Name="AmplitudeMirrorLine" Stroke="#7AAFA7" StrokeThickness="2" StrokeLineJoin="Round" />
            </Canvas>
        </Grid>
    </Border>
</Window>
