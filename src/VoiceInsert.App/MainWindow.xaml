<Window x:Class="VoiceInsert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceInsert" Height="530" Width="760"
        MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen"
        Icon="Assets/VoiceInsert.ico"
        PreviewKeyDown="WindowPreviewKeyDown"
        Loaded="WindowLoaded"
        Background="#F6F8F7"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#EDF4F1" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFDFB" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#1F2A28" />
        <SolidColorBrush x:Key="MutedBrush" Color="#66746E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#51B3A2" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#D9F0EA" />
        <SolidColorBrush x:Key="WarmBrush" Color="#E0A06F" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE6E1" />
        <SolidColorBrush x:Key="TooltipBrush" Color="#1F2A28" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Height" Value="30" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,1,6,3" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="7,2,7,3" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#10231F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FBF9" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource TooltipBrush}" />
            <Setter Property="Foreground" Value="#F8FBF9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#F8FBF9"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   MaxWidth="390" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ListBox SelectedIndex="{Binding SelectedSettingsPage}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="10,0"
                             ItemContainerStyle="{StaticResource NavItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem Content="{Binding Texts.General}"
                                     Tag="{Binding Texts.GeneralTip}"
                                     ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <ListBoxItem Content="{Binding Texts.Hotkey}"
                                     Tag="{Binding Texts.HotkeyTip}"
                                     ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <ListBoxItem Content="{Binding Texts.Audio}"
                                     Tag="{Binding Texts.AudioTip}"
                                     ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <ListBoxItem Content="{Binding Texts.TranscriptionApi}"
                                     Tag="{Binding Texts.TranscriptionApiTip}"
                                     ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <ListBoxItem Content="{Binding Texts.Insertion}"
                                     Tag="{Binding Texts.InsertionTip}"
                                     ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <ListBoxItem Content="{Binding Texts.Sounds}"
                                     Tag="{Binding Texts.SoundsTip}"
                                     ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <ListBoxItem Content="{Binding Texts.LogsDiagnostics}"
                                     Tag="{Binding Texts.LogsDiagnosticsTip}"
                                     ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    </ListBox>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,12">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <CheckBox Content="{Binding Texts.StartWithWindows}" IsChecked="{Binding StartWithWindows}" ToolTip="{Binding Texts.StartWithWindowsTip}" />
                        <CheckBox Content="{Binding Texts.LaunchMinimizedToTray}" IsChecked="{Binding LaunchMinimizedToTray}" ToolTip="{Binding Texts.LaunchMinimizedToTrayTip}" />
                        <CheckBox Content="{Binding Texts.ShowFloatingRecordingWindow}" IsChecked="{Binding ShowFloatingRecordingWindow}" ToolTip="{Binding Texts.ShowFloatingRecordingWindowTip}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{Binding Texts.Language}" ToolTip="{Binding Texts.LanguageTip}" />
                            <ComboBox Grid.Column="1"
                                      Width="145"
                                      HorizontalAlignment="Left"
                                      ToolTip="{Binding Texts.LanguageTip}"
                                      ItemsSource="{Binding UiLanguageItems}"
                                      SelectedValue="{Binding UiLanguage}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="{Binding Texts.CurrentHotkey}" ToolTip="{Binding Texts.CurrentHotkeyTip}" Margin="0,0,12,10" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Text="{Binding Hotkey}" Width="210" IsReadOnly="True" ToolTip="{Binding Texts.CurrentHotkeyTip}" />
                            <Button Content="{Binding Texts.ChangeHotkey}" Command="{Binding ChangeHotkeyCommand}" Width="100" Margin="8,0,0,0" ToolTip="{Binding Texts.CurrentHotkeyTip}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="{Binding Texts.TranslationHotkey}" ToolTip="{Binding Texts.TranslationHotkeyTip}" Margin="0,0,12,10" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Text="{Binding TranslationHotkey}" Width="210" IsReadOnly="True" ToolTip="{Binding Texts.TranslationHotkeyTip}" />
                            <Button Content="{Binding Texts.ChangeHotkey}" Command="{Binding ChangeTranslationHotkeyCommand}" Width="100" Margin="8,0,0,0" ToolTip="{Binding Texts.TranslationHotkeyTip}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="{Binding Texts.RecordingMode}" ToolTip="{Binding Texts.RecordingModeTip}" Margin="0,0,12,10" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Width="220" HorizontalAlignment="Left"
                                  ToolTip="{Binding Texts.RecordingModeTip}"
                                  ItemsSource="{Binding RecordingModeItems}"
                                  SelectedValue="{Binding RecordingMode}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="{Binding Texts.SilenceThreshold}" ToolTip="{Binding Texts.SilenceThresholdTip}" Margin="0,0,12,10" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SilenceThresholdPercent}" Width="110" HorizontalAlignment="Left" ToolTip="{Binding Texts.SilenceThresholdTip}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="4" Style="{StaticResource LabelText}" Text="{Binding Texts.SilenceTimeout}" ToolTip="{Binding Texts.SilenceTimeoutTip}" Margin="0,0,12,10" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SilenceTimeoutMilliseconds}" Width="110" HorizontalAlignment="Left" ToolTip="{Binding Texts.SilenceTimeoutTip}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="5" Style="{StaticResource LabelText}" Text="{Binding Texts.MaxRecordingSeconds}" ToolTip="{Binding Texts.MaxRecordingSecondsTip}" Margin="0,0,12,0" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxRecordingSeconds}" Width="110" HorizontalAlignment="Left" ToolTip="{Binding Texts.MaxRecordingSecondsTip}" />
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="{Binding Texts.MicrophoneDevice}" ToolTip="{Binding Texts.MicrophoneDeviceTip}" />
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding MicrophoneDevices}"
                                  SelectedItem="{Binding MicrophoneDeviceId}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip="{Binding MicrophoneDeviceId}"
                                  Margin="0,7,0,12">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="ToolTip" Value="{Binding}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <WrapPanel Grid.Row="2">
                            <Button Content="{Binding Texts.RefreshDevices}" Command="{Binding RefreshDevicesCommand}" Width="160" Margin="0,0,8,8" ToolTip="{Binding Texts.RefreshDevicesTip}" />
                            <Button Content="{Binding Texts.TestMicrophone}" Command="{Binding TestMicrophoneCommand}" Width="160" Margin="0,0,8,8" ToolTip="{Binding Texts.TestMicrophoneTip}" />
                        </WrapPanel>
                        <TextBlock Grid.Row="3" Text="{Binding MicrophoneStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LabelText}" Text="{Binding Texts.ApiProfile}" ToolTip="{Binding Texts.ApiProfileTip}" />
                        <Grid Grid.Column="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ApiProfiles}"
                                      SelectedValue="{Binding SelectedApiProfileId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      ToolTip="{Binding Texts.ApiProfileTip}"
                                      Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding ApiProfileName}" ToolTip="{Binding Texts.ApiProfileNameTip}" Margin="0,0,8,0" />
                            <Button Grid.Column="2"
                                    Command="{Binding AddApiProfileCommand}"
                                    ToolTip="{Binding Texts.AddApiProfileTip}"
                                    Style="{StaticResource ProfileIconButton}"
                                    Margin="0">
                                <Viewbox Stretch="Uniform" Margin="6">
                                    <Grid Width="24" Height="24">
                                        <Path Stroke="#10231F"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M 12 4 L 12 20 M 4 12 L 20 12" />
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="4"
                                    Command="{Binding DeleteApiProfileCommand}"
                                    ToolTip="{Binding Texts.DeleteApiProfileTip}"
                                    Style="{StaticResource ProfileIconButton}"
                                    Background="{StaticResource WarmBrush}">
                                <Viewbox Stretch="Uniform" Margin="6">
                                    <Grid Width="24" Height="24">
                                        <Path Stroke="#10231F"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M 4 12 L 20 12" />
                                    </Grid>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="{Binding Texts.BaseUrl}" ToolTip="{Binding Texts.BaseUrlTip}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaseUrl}" ToolTip="{Binding Texts.BaseUrlTip}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="{Binding Texts.ApiKey}" ToolTip="{Binding Texts.ApiKeyTip}" />
                        <PasswordBox x:Name="ApiKeyBox" Grid.Row="2" Grid.Column="1" ToolTip="{Binding Texts.ApiKeyTip}" Margin="0,0,0,8" PasswordChanged="ApiKeyChanged" />
                        <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="{Binding Texts.TranscriptionModel}" ToolTip="{Binding Texts.ModelTip}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Models}" Text="{Binding Model}" IsEditable="True" ToolTip="{Binding Texts.ModelTip}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Style="{StaticResource LabelText}" Text="Language" ToolTip="{Binding Texts.LanguageApiTip}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Language}" ToolTip="{Binding Texts.LanguageApiTip}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="5" Style="{StaticResource LabelText}" Text="{Binding Texts.Temperature}" ToolTip="{Binding Texts.TemperatureTip}" />
                        <ComboBox Grid.Row="5" Grid.Column="1"
                                  ItemsSource="{Binding TemperatureOptions}"
                                  SelectedItem="{Binding Temperature}"
                                  ToolTip="{Binding Texts.TemperatureTip}"
                                  Margin="0,0,0,8" />
                        <TextBlock Grid.Row="6" Style="{StaticResource LabelText}" Text="{Binding Texts.TimeoutSeconds}" ToolTip="{Binding Texts.TimeoutSecondsTip}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding RequestTimeoutSeconds}" ToolTip="{Binding Texts.TimeoutSecondsTip}" Margin="0,0,0,10" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding Texts.LoadModels}" Command="{Binding LoadModelsCommand}" Width="130" Margin="0,0,8,0" ToolTip="{Binding Texts.LoadModelsTip}" />
                            <Button Content="{Binding Texts.TestConnection}" Command="{Binding LoadModelsCommand}" Width="130" ToolTip="{Binding Texts.TestConnectionTip}" />
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <CheckBox Content="{Binding Texts.RestoreClipboard}" IsChecked="{Binding RestoreClipboardContent}" ToolTip="{Binding Texts.RestoreClipboardTip}" />
                        <TextBlock Style="{StaticResource LabelText}" Text="{Binding Texts.DelayBeforePaste}" ToolTip="{Binding Texts.DelayBeforePasteTip}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding DelayBeforePasteMilliseconds}" Width="110" HorizontalAlignment="Left" ToolTip="{Binding Texts.DelayBeforePasteTip}" Margin="0,7,0,10" />
                        <TextBlock Style="{StaticResource LabelText}" Text="{Binding Texts.DelayBeforeRestore}" ToolTip="{Binding Texts.DelayBeforeRestoreTip}" />
                        <TextBox Text="{Binding DelayBeforeClipboardRestoreMilliseconds}" Width="110" HorizontalAlignment="Left" ToolTip="{Binding Texts.DelayBeforeRestoreTip}" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="5">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <CheckBox Content="{Binding Texts.EnableSounds}" IsChecked="{Binding EnableSounds}" ToolTip="{Binding Texts.EnableSoundsTip}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{Binding Texts.TestStartRecordSound}" Command="{Binding TestStartRecordSoundCommand}" Width="245" Margin="0,0,8,8" ToolTip="{Binding Texts.TestStartRecordSoundTip}" />
                            <Button Content="{Binding Texts.TestStopRecordSound}" Command="{Binding TestStopRecordSoundCommand}" Width="245" Margin="0,0,8,8" ToolTip="{Binding Texts.TestStopRecordSoundTip}" />
                            <Button Content="{Binding Texts.TestErrorSound}" Command="{Binding TestErrorSoundCommand}" Width="190" Margin="0,0,8,8" ToolTip="{Binding Texts.TestErrorSoundTip}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="6">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Text="{Binding Texts.LastErrorSinceStart}" ToolTip="{Binding Texts.LastErrorSinceStartTip}" />
                        <TextBlock Text="{Binding LastErrorTime}" Margin="0,6,0,4" ToolTip="{Binding Texts.LastErrorSinceStartTip}" />
                        <TextBox Text="{Binding LastErrorMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" ToolTip="{Binding Texts.LastErrorSinceStartTip}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource LabelText}" Text="{Binding Texts.LogLevel}" ToolTip="{Binding Texts.LogLevelTip}" />
                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Width="180" HorizontalAlignment="Left" ToolTip="{Binding Texts.LogLevelTip}" Margin="0,7,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Texts.OpenLogsFolder}" Command="{Binding OpenLogsFolderCommand}" Width="170" Margin="0,0,8,0" ToolTip="{Binding Texts.OpenLogsFolderTip}" />
                            <Button Content="{Binding Texts.ClearLogs}" Command="{Binding ClearLogsCommand}" Width="140" Background="{StaticResource WarmBrush}" ToolTip="{Binding Texts.ClearLogsTip}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#F4F8F6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <Grid Margin="22,0,22,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentSoftBrush}" Padding="10,5" Margin="0,0,12,0" CornerRadius="6">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextAlignment="Left" />
                    </Border>
                    <Button Grid.Column="1" Content="{Binding Texts.Save}" Click="SaveClicked" Width="100" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="{Binding Texts.Close}" Click="CloseClicked" Width="100" Background="#CFDDD6" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
