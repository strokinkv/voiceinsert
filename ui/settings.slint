component Field inherits Rectangle {
    in-out property <string> value: "";

    height: 34px;
    background: #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 4px;

    TextInput {
        text <=> root.value;
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        color: #1f2a28;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
    }
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;

    height: 30px;
    background: selected ? #e6f2ee : transparent;
    border-radius: 4px;

    Text {
        text: root.label;
        color: selected ? #1f2a28 : #66746e;
        font-size: 13px;
        font-weight: selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <brush> fill: #cfddd6;
    callback clicked();

    width: 104px;
    height: 34px;
    background: touch.pressed ? #9ccfc4 : fill;
    border-radius: 4px;

    Text {
        text: root.label;
        color: #10231f;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    in-out property <string> status-text: "";
    in-out property <string> profile-line: "";
    in-out property <string> api-base-url: "";
    in-out property <string> model-name: "";
    in-out property <string> transcription-hotkey: "";
    in-out property <string> translation-hotkey: "";
    in-out property <string> recording-mode-line: "";
    in-out property <int> selected-page: 0;

    callback save();
    callback close();
    callback refresh-devices();
    callback test-microphone();
    callback load-models();
    callback test-api-connection();
    callback add-api-profile();
    callback delete-api-profile();
    callback change-transcription-hotkey();
    callback change-translation-hotkey();
    callback open-logs-folder();
    callback clear-logs();

    title: "VoiceInsert";
    width: 760px;
    height: 530px;
    background: #f6f8f7;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Text {
            text: "VoiceInsert";
            font-size: 22px;
            color: #1f2a28;
        }

        HorizontalLayout {
            spacing: 8px;
            NavItem { label: "General"; selected: true; }
            NavItem { label: "Hotkeys"; }
            NavItem { label: "Audio"; }
            NavItem { label: "API"; }
            NavItem { label: "Insertion"; }
            NavItem { label: "Sounds"; }
            NavItem { label: "Logs"; }
        }

        Rectangle {
            background: #fcfdfb;
            border-color: #dde6e1;
            border-width: 1px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text { text: "Settings"; color: #1f2a28; }
                Text { text: root.profile-line; color: #66746e; }

                Text { text: "API"; color: #66746e; }
                Field { value <=> root.api-base-url; }

                Text { text: "Model"; color: #66746e; }
                Field { value <=> root.model-name; }

                Text { text: "Transcription hotkey"; color: #66746e; }
                Field { value <=> root.transcription-hotkey; }

                Text { text: "Translation hotkey"; color: #66746e; }
                Field { value <=> root.translation-hotkey; }

                Text { text: root.recording-mode-line; color: #66746e; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.status-text;
                color: #66746e;
                horizontal-stretch: 1;
            }
            ActionButton {
                label: "Save";
                fill: #51b3a2;
                clicked => { root.save(); }
            }
            ActionButton {
                label: "Close";
                fill: #cfddd6;
                clicked => { root.close(); }
            }
        }
    }
}
