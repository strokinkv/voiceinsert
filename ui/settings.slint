component Label inherits Text {
    in property <string> label: "";

    text: label;
    color: #66746e;
    font-size: 13px;
}

component ValueText inherits Text {
    in property <string> label: "";

    text: label;
    color: #24312e;
    font-size: 14px;
}

component Field inherits Rectangle {
    in-out property <string> value: "";

    height: 34px;
    background: #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    TextInput {
        text <=> root.value;
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        color: #1f2a28;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
    }
}

component FieldRow inherits HorizontalLayout {
    in property <string> label: "";
    in-out property <string> value: "";
    in property <length> field-width: 360px;

    height: 34px;
    horizontal-stretch: 1;
    spacing: 14px;

    Label {
        label: root.label;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    Field {
        value <=> root.value;
        width: root.field-width;
    }
}

component ReadOnlyRow inherits HorizontalLayout {
    in property <string> name: "";
    in property <string> value: "";

    height: 28px;
    horizontal-stretch: 1;
    spacing: 14px;

    Label {
        label: root.name;
        width: 150px;
        vertical-alignment: center;
    }

    ValueText {
        label: root.value;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <string> mark: "";
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    background: selected ? #dceee9 : transparent;
    border-radius: 6px;

    Rectangle {
        x: 0;
        y: 6px;
        width: 3px;
        height: 24px;
        background: root.selected ? #51b3a2 : transparent;
        border-radius: 2px;
    }

    Rectangle {
        x: 14px;
        y: 7px;
        width: 22px;
        height: 22px;
        background: root.selected ? #51b3a2 : #d6e1dc;
        border-radius: 5px;

        Text {
            text: root.mark;
            color: root.selected ? #ffffff : #50615c;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.label;
        color: selected ? #1f2a28 : #61716b;
        font-size: 13px;
        font-weight: selected ? 700 : 400;
        x: 48px;
        y: 0;
        width: parent.width - 58px;
        height: parent.height;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <brush> fill: #cfddd6;
    in property <brush> hover-fill: #bfd1ca;
    callback clicked();

    width: 118px;
    height: 38px;
    background: touch.pressed ? #9ccfc4 : touch.has-hover ? hover-fill : fill;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #10231f;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component SmallButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 104px;
    height: 34px;
    background: touch.pressed ? #d5e5df : touch.has-hover ? #edf5f2 : #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #1f2a28;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component TinyButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 34px;
    height: 34px;
    background: touch.pressed ? #d5e5df : touch.has-hover ? #edf5f2 : #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #1f2a28;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component ToggleRow inherits HorizontalLayout {
    in property <string> label: "";
    in-out property <bool> checked: false;

    height: 30px;
    horizontal-stretch: 1;
    spacing: 12px;

    Text {
        text: root.label;
        color: #66746e;
        font-size: 13px;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    Rectangle {
        width: 48px;
        height: 26px;
        background: root.checked ? #51b3a2 : #d7e1dc;
        border-radius: 6px;

        Rectangle {
            x: root.checked ? 24px : 4px;
            y: 4px;
            width: 18px;
            height: 18px;
            background: #ffffff;
            border-radius: 5px;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.checked = !root.checked; }
        }
    }
}

component OptionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    background: selected ? #dceee9 : #ffffff;
    border-color: selected ? #90cbbd : #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: selected ? #163f36 : #50615c;
        font-size: 13px;
        font-weight: selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component PageTitle inherits Text {
    in property <string> label: "";

    text: label;
    color: #1f2a28;
    font-size: 22px;
    font-weight: 700;
}

component SectionTitle inherits Text {
    in property <string> label: "";

    text: label;
    color: #1f2a28;
    font-size: 15px;
    font-weight: 700;
}

component StatusPill inherits Rectangle {
    in property <string> label: "Ready";

    width: 116px;
    height: 28px;
    background: #e0f3ed;
    border-color: #a9d8ca;
    border-width: 1px;
    border-radius: 6px;

    Rectangle {
        x: 12px;
        y: 10px;
        width: 8px;
        height: 8px;
        background: #35a878;
        border-radius: 4px;
    }

    Text {
        text: root.label;
        x: 28px;
        y: 0;
        width: parent.width - 36px;
        height: parent.height;
        color: #17604a;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component Section inherits VerticalLayout {
    horizontal-stretch: 1;
    spacing: 8px;
}

export component SettingsWindow inherits Window {
    in-out property <string> status-text: "";
    in-out property <string> profile-line: "";
    in-out property <string> api-base-url: "";
    in-out property <string> model-name: "";
    in-out property <string> profile-name: "";
    in-out property <string> api-key: "";
    in-out property <string> language: "";
    in-out property <string> temperature: "";
    in-out property <string> request-timeout-seconds: "";
    in-out property <string> transcription-hotkey: "";
    in-out property <string> translation-hotkey: "";
    in-out property <string> recording-mode: "";
    in-out property <string> silence-threshold-percent: "";
    in-out property <string> silence-timeout-milliseconds: "";
    in-out property <string> max-recording-seconds: "";
    in-out property <bool> start-with-windows: false;
    in-out property <string> ui-language: "";
    in-out property <bool> enable-sounds: true;
    in-out property <bool> restore-clipboard-content: true;
    in-out property <string> delay-before-paste-milliseconds: "";
    in-out property <string> delay-before-clipboard-restore-milliseconds: "";
    in-out property <string> logs-folder: "";
    in-out property <string> log-level: "";
    in-out property <string> last-error-line: "";
    in-out property <int> selected-page: 0;
    property <bool> is-russian: root.ui-language == "Russian";

    callback save();
    callback close();
    callback load-models();
    callback test-api-connection();
    callback add-api-profile();
    callback delete-api-profile();
    callback change-transcription-hotkey();
    callback change-translation-hotkey();
    callback open-logs-folder();
    callback clear-logs();

    title: "VoiceInsert";
    icon: @image-url("../assets/VoiceInsert.ico");
    width: 1080px;
    height: 650px;
    background: #f6f8f7;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 238px;
            background: #edf3f0;
            border-color: #d8e4de;
            border-width: 0px;

            VerticalLayout {
                padding-left: 22px;
                padding-right: 18px;
                padding-top: 22px;
                padding-bottom: 18px;
                spacing: 10px;

                Text {
                    text: "VoiceInsert";
                    color: #1f2a28;
                    font-size: 24px;
                    font-weight: 700;
                }

                Text {
                    text: root.profile-line;
                    color: #66746e;
                    font-size: 13px;
                    height: 22px;
                    vertical-alignment: center;
                }

                Rectangle { height: 6px; background: transparent; }

                NavItem { mark: "G"; label: root.is-russian ? "Общие" : "General"; selected: root.selected-page == 0; clicked => { root.selected-page = 0; } }
                NavItem { mark: "H"; label: root.is-russian ? "Горячие клавиши" : "Hotkeys"; selected: root.selected-page == 1; clicked => { root.selected-page = 1; } }
                NavItem { mark: "API"; label: root.is-russian ? "API профиль" : "API Profile"; selected: root.selected-page == 2; clicked => { root.selected-page = 2; } }
                NavItem { mark: "I"; label: root.is-russian ? "Вставка" : "Insertion"; selected: root.selected-page == 3; clicked => { root.selected-page = 3; } }
                NavItem { mark: "S"; label: root.is-russian ? "Звуки" : "Sounds"; selected: root.selected-page == 4; clicked => { root.selected-page = 4; } }
                NavItem { mark: "L"; label: root.is-russian ? "Логи" : "Logs"; selected: root.selected-page == 5; clicked => { root.selected-page = 5; } }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Rectangle {
                    height: 66px;
                    background: #e5eee9;
                    border-color: #d3e0da;
                    border-width: 1px;
                    border-radius: 6px;

                    Text {
                        text: root.status-text == "" ? (root.is-russian ? "Готово" : "Ready") : root.status-text;
                        x: 12px;
                        y: 8px;
                        width: parent.width - 24px;
                        height: parent.height - 16px;
                        color: #50615c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            background: #f8faf9;
            horizontal-stretch: 1;

            VerticalLayout {
                padding-left: 26px;
                padding-right: 26px;
                padding-top: 22px;
                padding-bottom: 22px;
                spacing: 12px;

                HorizontalLayout {
                    height: 40px;
                    spacing: 14px;

                    PageTitle {
                        label: root.selected-page == 0 ? (root.is-russian ? "Общие" : "General") :
                            root.selected-page == 1 ? (root.is-russian ? "Горячие клавиши" : "Hotkeys") :
                            root.selected-page == 2 ? (root.is-russian ? "API профиль" : "API Profile") :
                            root.selected-page == 3 ? (root.is-russian ? "Вставка" : "Insertion") :
                            root.selected-page == 4 ? (root.is-russian ? "Звуки" : "Sounds") : (root.is-russian ? "Логи" : "Logs");
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    StatusPill { label: root.is-russian ? "Готово" : "Ready"; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: #ffffff;
                    border-color: #dce6e1;
                    border-width: 1px;
                    border-radius: 6px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        if root.selected-page == 0: VerticalLayout {
                            spacing: 12px;

                            Section {
                                SectionTitle { label: root.is-russian ? "Приложение" : "Application"; }
                                ToggleRow { label: root.is-russian ? "Запускать вместе с Windows" : "Start with Windows"; checked <=> root.start-with-windows; }
                                ReadOnlyRow { name: root.is-russian ? "Запуск" : "Startup"; value: root.is-russian ? "Только в трее" : "Tray only"; }
                                ReadOnlyRow { name: root.is-russian ? "Окно записи" : "Recording window"; value: root.is-russian ? "Всегда показывать" : "Always shown"; }

                                Label { label: root.is-russian ? "Язык" : "Language"; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    OptionButton { label: "Русский"; selected: root.ui-language == "Russian"; clicked => { root.ui-language = "Russian"; } }
                                    OptionButton { label: "English"; selected: root.ui-language == "English"; clicked => { root.ui-language = "English"; } }
                                }
                            }
                        }

                        if root.selected-page == 1: VerticalLayout {
                            spacing: 10px;

                            FieldRow { label: root.is-russian ? "Клавиша транскрибации" : "Transcription hotkey"; value <=> root.transcription-hotkey; }
                            FieldRow { label: root.is-russian ? "Клавиша перевода" : "Translation hotkey"; value <=> root.translation-hotkey; }

                            Label { label: root.is-russian ? "Режим записи" : "Recording mode"; }
                            HorizontalLayout {
                                spacing: 10px;
                                OptionButton { label: root.is-russian ? "Переключатель" : "Toggle"; selected: root.recording-mode == "Toggle"; clicked => { root.recording-mode = "Toggle"; } }
                                OptionButton { label: root.is-russian ? "Удержание" : "Hold"; selected: root.recording-mode == "Hold"; clicked => { root.recording-mode = "Hold"; } }
                                OptionButton { label: root.is-russian ? "Тишина" : "Silence"; selected: root.recording-mode == "SilenceTimeout"; clicked => { root.recording-mode = "SilenceTimeout"; } }
                            }

                            FieldRow { label: root.is-russian ? "Порог тишины, %" : "Silence threshold, %"; value <=> root.silence-threshold-percent; }
                            FieldRow { label: root.is-russian ? "Таймаут тишины, мс" : "Silence timeout, ms"; value <=> root.silence-timeout-milliseconds; }
                            FieldRow { label: root.is-russian ? "Макс. длительность, сек" : "Max duration, sec"; value <=> root.max-recording-seconds; }
                        }

                        if root.selected-page == 2: VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Label { label: root.is-russian ? "Имя профиля" : "Profile name"; horizontal-stretch: 1; vertical-alignment: center; }
                                Field { value <=> root.profile-name; width: 360px; }
                                TinyButton { label: "+"; clicked => { root.add-api-profile(); } }
                                TinyButton { label: "-"; clicked => { root.delete-api-profile(); } }
                            }

                            FieldRow { label: "Base URL"; value <=> root.api-base-url; }
                            FieldRow { label: "API key"; value <=> root.api-key; }
                            FieldRow { label: root.is-russian ? "Модель" : "Model"; value <=> root.model-name; }
                            FieldRow { label: root.is-russian ? "Язык распознавания" : "Language"; value <=> root.language; }
                            FieldRow { label: root.is-russian ? "Температура" : "Temperature"; value <=> root.temperature; }
                            FieldRow { label: root.is-russian ? "Таймаут, сек" : "Timeout, sec"; value <=> root.request-timeout-seconds; }

                            HorizontalLayout {
                                spacing: 10px;
                                SmallButton { label: root.is-russian ? "Модели" : "Models"; clicked => { root.load-models(); } }
                                SmallButton { label: root.is-russian ? "Тест" : "Test"; clicked => { root.test-api-connection(); } }
                            }
                        }

                        if root.selected-page == 3: VerticalLayout {
                            spacing: 12px;

                            Section {
                                SectionTitle { label: root.is-russian ? "Буфер обмена" : "Clipboard"; }
                                ReadOnlyRow { name: root.is-russian ? "Вставка" : "Insertion"; value: root.is-russian ? "Через буфер обмена" : "Paste through clipboard"; }
                                ToggleRow { label: root.is-russian ? "Восстанавливать прежнее содержимое буфера" : "Restore previous clipboard content"; checked <=> root.restore-clipboard-content; }
                            }

                            FieldRow { label: root.is-russian ? "Задержка перед вставкой, мс" : "Delay before paste, ms"; value <=> root.delay-before-paste-milliseconds; }
                            FieldRow { label: root.is-russian ? "Задержка перед восстановлением, мс" : "Delay before restore, ms"; value <=> root.delay-before-clipboard-restore-milliseconds; }
                        }

                        if root.selected-page == 4: VerticalLayout {
                            spacing: 12px;

                            Section {
                                SectionTitle { label: root.is-russian ? "События" : "Events"; }
                                ToggleRow { label: root.is-russian ? "Включить звуки" : "Enable sounds"; checked <=> root.enable-sounds; }
                                ReadOnlyRow { name: root.is-russian ? "Начало записи" : "Record start"; value: root.enable-sounds ? (root.is-russian ? "Включено" : "Enabled") : (root.is-russian ? "Выключено" : "Disabled"); }
                                ReadOnlyRow { name: root.is-russian ? "Остановка записи" : "Record stop"; value: root.enable-sounds ? (root.is-russian ? "Включено" : "Enabled") : (root.is-russian ? "Выключено" : "Disabled"); }
                                ReadOnlyRow { name: root.is-russian ? "Ошибка" : "Error"; value: root.enable-sounds ? (root.is-russian ? "Включено" : "Enabled") : (root.is-russian ? "Выключено" : "Disabled"); }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                SmallButton { label: root.is-russian ? "Старт" : "Start"; }
                                SmallButton { label: root.is-russian ? "Стоп" : "Stop"; }
                                SmallButton { label: root.is-russian ? "Ошибка" : "Error"; }
                            }
                        }

                        if root.selected-page == 5: VerticalLayout {
                            spacing: 12px;

                            Section {
                                SectionTitle { label: root.is-russian ? "Диагностика" : "Diagnostics"; }
                                ReadOnlyRow { name: root.is-russian ? "Папка логов" : "Logs folder"; value: root.logs-folder; }
                                ReadOnlyRow { name: root.is-russian ? "Последний статус" : "Last status"; value: root.status-text == "" ? (root.is-russian ? "Готово" : "Ready") : root.status-text; }
                                ReadOnlyRow { name: root.is-russian ? "Последняя ошибка" : "Last error"; value: root.last-error-line == "" ? (root.is-russian ? "Ошибок в этой сессии нет" : "No error in this session") : root.last-error-line; }
                            }

                            Section {
                                SectionTitle { label: root.is-russian ? "Уровень логов" : "Log level"; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    OptionButton { label: root.is-russian ? "Инфо" : "Information"; selected: root.log-level == "Information"; clicked => { root.log-level = "Information"; } }
                                    OptionButton { label: root.is-russian ? "Отладка" : "Debug"; selected: root.log-level == "Debug"; clicked => { root.log-level = "Debug"; } }
                                    OptionButton { label: root.is-russian ? "Предупреждения" : "Warning"; selected: root.log-level == "Warning"; clicked => { root.log-level = "Warning"; } }
                                    OptionButton { label: root.is-russian ? "Ошибки" : "Error"; selected: root.log-level == "Error"; clicked => { root.log-level = "Error"; } }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                SmallButton { label: root.is-russian ? "Открыть" : "Open"; clicked => { root.open-logs-folder(); } }
                                SmallButton { label: root.is-russian ? "Очистить" : "Clear"; clicked => { root.clear-logs(); } }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                HorizontalLayout {
                    height: 42px;
                    spacing: 10px;

                    ValueText {
                        label: root.status-text == "" ? (root.is-russian ? "Готово" : "Ready") : root.status-text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    ActionButton { label: root.is-russian ? "Сохранить" : "Save"; fill: #51b3a2; hover-fill: #5ec1af; clicked => { root.save(); } }
                    ActionButton { label: root.is-russian ? "Закрыть" : "Close"; fill: #cfddd6; hover-fill: #c4d4cd; clicked => { root.close(); } }
                }
            }
        }
    }
}
