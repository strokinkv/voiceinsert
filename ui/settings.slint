component Field inherits Rectangle {
    in-out property <string> value: "";

    height: 34px;
    background: #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 4px;

    TextInput {
        text <=> root.value;
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        color: #1f2a28;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
    }
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    background: selected ? #e6f2ee : transparent;
    border-radius: 4px;

    Text {
        text: root.label;
        color: selected ? #1f2a28 : #66746e;
        font-size: 13px;
        font-weight: selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <brush> fill: #cfddd6;
    callback clicked();

    width: 104px;
    height: 34px;
    background: touch.pressed ? #9ccfc4 : fill;
    border-radius: 4px;

    Text {
        text: root.label;
        color: #10231f;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    in-out property <string> status-text: "";
    in-out property <string> profile-line: "";
    in-out property <string> api-base-url: "";
    in-out property <string> model-name: "";
    in-out property <string> transcription-hotkey: "";
    in-out property <string> translation-hotkey: "";
    in-out property <string> recording-mode-line: "";
    in-out property <int> selected-page: 0;

    callback save();
    callback close();
    callback refresh-devices();
    callback test-microphone();
    callback load-models();
    callback test-api-connection();
    callback add-api-profile();
    callback delete-api-profile();
    callback change-transcription-hotkey();
    callback change-translation-hotkey();
    callback open-logs-folder();
    callback clear-logs();

    title: "VoiceInsert";
    width: 760px;
    height: 530px;
    background: #f6f8f7;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Text {
            text: "VoiceInsert";
            font-size: 22px;
            color: #1f2a28;
        }

        HorizontalLayout {
            spacing: 8px;
            NavItem {
                label: "General";
                selected: root.selected-page == 0;
                clicked => { root.selected-page = 0; }
            }
            NavItem {
                label: "Hotkeys";
                selected: root.selected-page == 1;
                clicked => { root.selected-page = 1; }
            }
            NavItem {
                label: "Audio";
                selected: root.selected-page == 2;
                clicked => { root.selected-page = 2; }
            }
            NavItem {
                label: "API";
                selected: root.selected-page == 3;
                clicked => { root.selected-page = 3; }
            }
            NavItem {
                label: "Insertion";
                selected: root.selected-page == 4;
                clicked => { root.selected-page = 4; }
            }
            NavItem {
                label: "Sounds";
                selected: root.selected-page == 5;
                clicked => { root.selected-page = 5; }
            }
            NavItem {
                label: "Logs";
                selected: root.selected-page == 6;
                clicked => { root.selected-page = 6; }
            }
        }

        Rectangle {
            background: #fcfdfb;
            border-color: #dde6e1;
            border-width: 1px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                if root.selected-page == 0: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Settings"; color: #1f2a28; }
                    Text { text: root.profile-line; color: #66746e; }
                    Text { text: root.recording-mode-line; color: #66746e; }
                }

                if root.selected-page == 1: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Hotkeys"; color: #1f2a28; }

                    Text { text: "Transcription hotkey"; color: #66746e; }
                    Field { value <=> root.transcription-hotkey; }

                    Text { text: "Translation hotkey"; color: #66746e; }
                    Field { value <=> root.translation-hotkey; }
                }

                if root.selected-page == 2: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Audio"; color: #1f2a28; }
                }

                if root.selected-page == 3: VerticalLayout {
                    spacing: 8px;
                    Text { text: "API"; color: #1f2a28; }
                    Text { text: root.profile-line; color: #66746e; }

                    Text { text: "Base URL"; color: #66746e; }
                    Field { value <=> root.api-base-url; }

                    Text { text: "Model"; color: #66746e; }
                    Field { value <=> root.model-name; }

                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton {
                            label: "Models";
                            fill: #cfddd6;
                            clicked => { root.load-models(); }
                        }
                        ActionButton {
                            label: "Test";
                            fill: #cfddd6;
                            clicked => { root.test-api-connection(); }
                        }
                    }
                }

                if root.selected-page == 4: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Insertion"; color: #1f2a28; }
                }

                if root.selected-page == 5: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Sounds"; color: #1f2a28; }
                }

                if root.selected-page == 6: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Logs"; color: #1f2a28; }
                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton {
                            label: "Open";
                            fill: #cfddd6;
                            clicked => { root.open-logs-folder(); }
                        }
                        ActionButton {
                            label: "Clear";
                            fill: #cfddd6;
                            clicked => { root.clear-logs(); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.status-text;
                color: #66746e;
                horizontal-stretch: 1;
            }
            ActionButton {
                label: "Save";
                fill: #51b3a2;
                clicked => { root.save(); }
            }
            ActionButton {
                label: "Close";
                fill: #cfddd6;
                clicked => { root.close(); }
            }
        }
    }
}
