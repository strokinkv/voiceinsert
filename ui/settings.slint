component Field inherits Rectangle {
    in-out property <string> value: "";

    height: 36px;
    background: #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    TextInput {
        text <=> root.value;
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        color: #1f2a28;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
    }
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <string> mark: "";
    in property <bool> selected: false;
    callback clicked();

    height: 42px;
    background: selected ? #dceee9 : transparent;
    border-radius: 6px;

    Rectangle {
        x: 0;
        y: 7px;
        width: 3px;
        height: 28px;
        background: root.selected ? #51b3a2 : transparent;
        border-radius: 2px;
    }

    Rectangle {
        x: 14px;
        y: 9px;
        width: 24px;
        height: 24px;
        background: root.selected ? #51b3a2 : #d6e1dc;
        border-radius: 5px;

        Text {
            text: root.mark;
            color: root.selected ? #ffffff : #50615c;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.label;
        color: selected ? #1f2a28 : #61716b;
        font-size: 14px;
        font-weight: selected ? 700 : 400;
        x: 48px;
        y: 0;
        width: parent.width - 58px;
        height: parent.height;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <brush> fill: #cfddd6;
    in property <brush> hover-fill: #bfd1ca;
    callback clicked();

    width: 118px;
    height: 38px;
    background: touch.pressed ? #9ccfc4 : touch.has-hover ? hover-fill : fill;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #10231f;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component SmallButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 104px;
    height: 34px;
    background: touch.pressed ? #d5e5df : touch.has-hover ? #edf5f2 : #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #1f2a28;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component TinyButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 34px;
    height: 34px;
    background: touch.pressed ? #d5e5df : touch.has-hover ? #edf5f2 : #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #1f2a28;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component ToggleRow inherits HorizontalLayout {
    in property <string> label: "";
    in-out property <bool> checked: false;

    height: 34px;
    spacing: 12px;

    Text {
        text: root.label;
        color: #66746e;
        font-size: 13px;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    Rectangle {
        width: 48px;
        height: 26px;
        background: root.checked ? #51b3a2 : #d7e1dc;
        border-radius: 6px;

        Rectangle {
            x: root.checked ? 24px : 4px;
            y: 4px;
            width: 18px;
            height: 18px;
            background: #ffffff;
            border-radius: 5px;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.checked = !root.checked; }
        }
    }
}

component OptionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();

    height: 34px;
    horizontal-stretch: 1;
    background: selected ? #dceee9 : #ffffff;
    border-color: selected ? #90cbbd : #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: selected ? #163f36 : #50615c;
        font-size: 13px;
        font-weight: selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component PageTitle inherits Text {
    in property <string> label: "";

    text: label;
    color: #1f2a28;
    font-size: 24px;
    font-weight: 700;
}

component SectionTitle inherits Text {
    in property <string> label: "";

    text: label;
    color: #1f2a28;
    font-size: 15px;
    font-weight: 700;
}

component Label inherits Text {
    in property <string> label: "";

    text: label;
    color: #66746e;
    font-size: 13px;
}

component ValueText inherits Text {
    in property <string> label: "";

    text: label;
    color: #24312e;
    font-size: 14px;
}

component KeyValue inherits HorizontalLayout {
    in property <string> name: "";
    in property <string> value: "";

    height: 28px;
    spacing: 12px;

    Label {
        label: root.name;
        width: 150px;
        vertical-alignment: center;
    }

    ValueText {
        label: root.value;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: #dfe8e4;
}

component StatusPill inherits Rectangle {
    in property <string> label: "Ready";

    width: 116px;
    height: 28px;
    background: #e0f3ed;
    border-color: #a9d8ca;
    border-width: 1px;
    border-radius: 6px;

    Rectangle {
        x: 12px;
        y: 10px;
        width: 8px;
        height: 8px;
        background: #35a878;
        border-radius: 4px;
    }

    Text {
        text: root.label;
        x: 28px;
        y: 0;
        width: parent.width - 36px;
        height: parent.height;
        color: #17604a;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component Section inherits VerticalLayout {
    spacing: 10px;
}

export component SettingsWindow inherits Window {
    in-out property <string> status-text: "";
    in-out property <string> profile-line: "";
    in-out property <string> api-base-url: "";
    in-out property <string> model-name: "";
    in-out property <string> profile-name: "";
    in-out property <string> api-key: "";
    in-out property <string> language: "";
    in-out property <string> temperature: "";
    in-out property <string> request-timeout-seconds: "";
    in-out property <string> transcription-hotkey: "";
    in-out property <string> translation-hotkey: "";
    in-out property <string> recording-mode: "";
    in-out property <string> silence-threshold-percent: "";
    in-out property <string> silence-timeout-milliseconds: "";
    in-out property <string> max-recording-seconds: "";
    in-out property <string> input-device-index: "";
    in-out property <bool> start-with-windows: false;
    in-out property <string> ui-language: "";
    in-out property <bool> launch-minimized-to-tray: true;
    in-out property <bool> show-floating-recording-window: true;
    in-out property <bool> enable-sounds: true;
    in-out property <bool> restore-clipboard-content: true;
    in-out property <string> delay-before-paste-milliseconds: "";
    in-out property <string> delay-before-clipboard-restore-milliseconds: "";
    in-out property <string> last-error-line: "";
    in-out property <int> selected-page: 0;

    callback save();
    callback close();
    callback refresh-devices();
    callback test-microphone();
    callback load-models();
    callback test-api-connection();
    callback add-api-profile();
    callback delete-api-profile();
    callback change-transcription-hotkey();
    callback change-translation-hotkey();
    callback open-logs-folder();
    callback clear-logs();

    title: "VoiceInsert";
    width: 1080px;
    height: 720px;
    background: #f6f8f7;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 238px;
            background: #edf3f0;
            border-color: #d8e4de;
            border-width: 0px;

            VerticalLayout {
                padding-left: 22px;
                padding-right: 18px;
                padding-top: 24px;
                padding-bottom: 18px;
                spacing: 12px;

                Text {
                    text: "VoiceInsert";
                    color: #1f2a28;
                    font-size: 24px;
                    font-weight: 700;
                }

                Text {
                    text: root.profile-line;
                    color: #66746e;
                    font-size: 13px;
                    height: 22px;
                    vertical-alignment: center;
                }

                Rectangle { height: 10px; background: transparent; }

                NavItem { mark: "G"; label: "General"; selected: root.selected-page == 0; clicked => { root.selected-page = 0; } }
                NavItem { mark: "H"; label: "Hotkeys"; selected: root.selected-page == 1; clicked => { root.selected-page = 1; } }
                NavItem { mark: "A"; label: "Audio"; selected: root.selected-page == 2; clicked => { root.selected-page = 2; } }
                NavItem { mark: "API"; label: "API"; selected: root.selected-page == 3; clicked => { root.selected-page = 3; } }
                NavItem { mark: "I"; label: "Insertion"; selected: root.selected-page == 4; clicked => { root.selected-page = 4; } }
                NavItem { mark: "S"; label: "Sounds"; selected: root.selected-page == 5; clicked => { root.selected-page = 5; } }
                NavItem { mark: "L"; label: "Logs"; selected: root.selected-page == 6; clicked => { root.selected-page = 6; } }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Rectangle {
                    height: 66px;
                    background: #e5eee9;
                    border-color: #d3e0da;
                    border-width: 1px;
                    border-radius: 6px;

                    Text {
                        text: root.status-text == "" ? "Ready" : root.status-text;
                        x: 12px;
                        y: 8px;
                        width: parent.width - 24px;
                        height: parent.height - 16px;
                        color: #50615c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            background: #f8faf9;
            horizontal-stretch: 1;

            VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 28px;
                padding-bottom: 22px;
                spacing: 18px;

                HorizontalLayout {
                    height: 44px;
                    spacing: 14px;

                    PageTitle {
                        label: root.selected-page == 0 ? "General" :
                            root.selected-page == 1 ? "Hotkeys" :
                            root.selected-page == 2 ? "Audio" :
                            root.selected-page == 3 ? "API" :
                            root.selected-page == 4 ? "Insertion" :
                            root.selected-page == 5 ? "Sounds" : "Logs";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    StatusPill { label: "Ready"; }
                }

                Rectangle {
                    height: 74px;
                    background: #ffffff;
                    border-color: #dce6e1;
                    border-width: 1px;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 22px;

                        KeyValue { name: "Profile"; value: root.profile-line; }
                        KeyValue { name: "API"; value: root.api-base-url; }
                    }
                }

                Rectangle {
                    background: #ffffff;
                    border-color: #dce6e1;
                    border-width: 1px;
                    border-radius: 6px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                        if root.selected-page == 0: VerticalLayout {
                            spacing: 18px;

                            Section {
                                SectionTitle { label: "Profile"; }
                                KeyValue { name: "Active profile"; value: root.profile-name; }
                                KeyValue { name: "Endpoint"; value: root.api-base-url; }
                                KeyValue { name: "Model"; value: root.model-name; }
                            }

                            Divider {}

                            Section {
                                SectionTitle { label: "Application"; }
                                ToggleRow { label: "Start with Windows"; checked <=> root.start-with-windows; }

                                Label { label: "Language"; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    OptionButton { label: "Русский"; selected: root.ui-language == "Russian"; clicked => { root.ui-language = "Russian"; } }
                                    OptionButton { label: "English"; selected: root.ui-language == "English"; clicked => { root.ui-language = "English"; } }
                                }

                                ToggleRow { label: "Launch minimized to tray"; checked <=> root.launch-minimized-to-tray; }
                                ToggleRow { label: "Show floating recording window"; checked <=> root.show-floating-recording-window; }
                            }
                        }

                        if root.selected-page == 1: VerticalLayout {
                            spacing: 14px;

                            Label { label: "Transcription hotkey"; }
                            Field { value <=> root.transcription-hotkey; }

                            Label { label: "Translation hotkey"; }
                            Field { value <=> root.translation-hotkey; }

                            Label { label: "Recording mode"; }
                            HorizontalLayout {
                                spacing: 10px;
                                OptionButton { label: "Toggle"; selected: root.recording-mode == "Toggle"; clicked => { root.recording-mode = "Toggle"; } }
                                OptionButton { label: "Hold"; selected: root.recording-mode == "Hold"; clicked => { root.recording-mode = "Hold"; } }
                                OptionButton { label: "Silence"; selected: root.recording-mode == "SilenceTimeout"; clicked => { root.recording-mode = "SilenceTimeout"; } }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Silence threshold, %"; }
                                    Field { value <=> root.silence-threshold-percent; }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Silence timeout, ms"; }
                                    Field { value <=> root.silence-timeout-milliseconds; }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Max duration, sec"; }
                                    Field { value <=> root.max-recording-seconds; }
                                }
                            }
                        }

                        if root.selected-page == 2: VerticalLayout {
                            spacing: 18px;

                            Section {
                                SectionTitle { label: "Input"; }
                                KeyValue { name: "Microphone"; value: "System default input device"; }
                                KeyValue { name: "Capture"; value: "Microphone to WAV"; }
                                KeyValue { name: "Status"; value: "Ready"; }
                                KeyValue { name: "Level"; value: "Idle"; }
                            }

                            Label { label: "Microphone device index"; }
                            Field { value <=> root.input-device-index; }

                            HorizontalLayout {
                                spacing: 10px;
                                SmallButton { label: "Refresh"; clicked => { root.refresh-devices(); } }
                                SmallButton { label: "Test mic"; clicked => { root.test-microphone(); } }
                            }
                        }

                        if root.selected-page == 3: VerticalLayout {
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 8px;
                                Field { value <=> root.profile-name; horizontal-stretch: 1; }
                                TinyButton { label: "+"; clicked => { root.add-api-profile(); } }
                                TinyButton { label: "-"; clicked => { root.delete-api-profile(); } }
                            }

                            Label { label: "Base URL"; }
                            Field { value <=> root.api-base-url; }

                            Label { label: "API key"; }
                            Field { value <=> root.api-key; }

                            Label { label: "Model"; }
                            Field { value <=> root.model-name; }

                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Language"; }
                                    Field { value <=> root.language; }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Temperature"; }
                                    Field { value <=> root.temperature; }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Timeout, sec"; }
                                    Field { value <=> root.request-timeout-seconds; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                SmallButton { label: "Models"; clicked => { root.load-models(); } }
                                SmallButton { label: "Test"; clicked => { root.test-api-connection(); } }
                            }
                        }

                        if root.selected-page == 4: VerticalLayout {
                            spacing: 18px;

                            Section {
                                SectionTitle { label: "Clipboard"; }
                                KeyValue { name: "Insertion"; value: "Paste through clipboard"; }
                                ToggleRow { label: "Restore previous clipboard content"; checked <=> root.restore-clipboard-content; }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Delay before paste, ms"; }
                                    Field { value <=> root.delay-before-paste-milliseconds; }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { label: "Delay before restore, ms"; }
                                    Field { value <=> root.delay-before-clipboard-restore-milliseconds; }
                                }
                            }
                        }

                        if root.selected-page == 5: VerticalLayout {
                            spacing: 18px;

                            Section {
                                SectionTitle { label: "Events"; }
                                ToggleRow { label: "Enable sounds"; checked <=> root.enable-sounds; }
                                KeyValue { name: "Record start"; value: root.enable-sounds ? "Enabled" : "Disabled"; }
                                KeyValue { name: "Record stop"; value: root.enable-sounds ? "Enabled" : "Disabled"; }
                                KeyValue { name: "Error"; value: root.enable-sounds ? "Enabled" : "Disabled"; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                SmallButton { label: "Start"; }
                                SmallButton { label: "Stop"; }
                                SmallButton { label: "Error"; }
                            }
                        }

                        if root.selected-page == 6: VerticalLayout {
                            spacing: 18px;

                            Section {
                                SectionTitle { label: "Diagnostics"; }
                                KeyValue { name: "Last status"; value: root.status-text == "" ? "Ready" : root.status-text; }
                                KeyValue { name: "Last error"; value: root.last-error-line == "" ? "No error in this session" : root.last-error-line; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                SmallButton { label: "Open"; clicked => { root.open-logs-folder(); } }
                                SmallButton { label: "Clear"; clicked => { root.clear-logs(); } }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 42px;
                    spacing: 10px;

                    ValueText {
                        label: root.status-text == "" ? "Ready" : root.status-text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    ActionButton { label: "Save"; fill: #51b3a2; hover-fill: #5ec1af; clicked => { root.save(); } }
                    ActionButton { label: "Close"; fill: #cfddd6; hover-fill: #c4d4cd; clicked => { root.close(); } }
                }
            }
        }
    }
}
