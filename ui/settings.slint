component Field inherits Rectangle {
    in-out property <string> value: "";

    height: 34px;
    background: #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 4px;

    TextInput {
        text <=> root.value;
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        color: #1f2a28;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
    }
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();

    height: 38px;
    background: selected ? #dceee9 : transparent;
    border-radius: 5px;

    Text {
        text: root.label;
        color: selected ? #1f2a28 : #66746e;
        font-size: 14px;
        font-weight: selected ? 600 : 400;
        x: 14px;
        width: parent.width - 28px;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <brush> fill: #cfddd6;
    callback clicked();

    width: 104px;
    height: 34px;
    background: touch.pressed ? #9ccfc4 : fill;
    border-radius: 4px;

    Text {
        text: root.label;
        color: #10231f;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PageTitle inherits Text {
    in property <string> label: "";

    text: label;
    color: #1f2a28;
    font-size: 18px;
    font-weight: 600;
}

component Label inherits Text {
    in property <string> label: "";

    text: label;
    color: #66746e;
    font-size: 13px;
}

component InfoLine inherits Text {
    in property <string> label: "";

    text: label;
    color: #1f2a28;
    font-size: 14px;
}

export component SettingsWindow inherits Window {
    in-out property <string> status-text: "";
    in-out property <string> profile-line: "";
    in-out property <string> api-base-url: "";
    in-out property <string> model-name: "";
    in-out property <string> transcription-hotkey: "";
    in-out property <string> translation-hotkey: "";
    in-out property <string> recording-mode-line: "";
    in-out property <int> selected-page: 0;

    callback save();
    callback close();
    callback refresh-devices();
    callback test-microphone();
    callback load-models();
    callback test-api-connection();
    callback add-api-profile();
    callback delete-api-profile();
    callback change-transcription-hotkey();
    callback change-translation-hotkey();
    callback open-logs-folder();
    callback clear-logs();

    title: "VoiceInsert";
    width: 820px;
    height: 520px;
    background: #f6f8f7;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 190px;
            background: #edf3f0;
            border-color: #d8e4de;
            border-width: 0px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "VoiceInsert";
                    color: #1f2a28;
                    font-size: 22px;
                    font-weight: 600;
                }

                Text {
                    text: root.profile-line;
                    color: #66746e;
                    font-size: 13px;
                }

                Rectangle { height: 8px; background: transparent; }

                NavItem { label: "General"; selected: root.selected-page == 0; clicked => { root.selected-page = 0; } }
                NavItem { label: "Hotkeys"; selected: root.selected-page == 1; clicked => { root.selected-page = 1; } }
                NavItem { label: "Audio"; selected: root.selected-page == 2; clicked => { root.selected-page = 2; } }
                NavItem { label: "API"; selected: root.selected-page == 3; clicked => { root.selected-page = 3; } }
                NavItem { label: "Insertion"; selected: root.selected-page == 4; clicked => { root.selected-page = 4; } }
                NavItem { label: "Sounds"; selected: root.selected-page == 5; clicked => { root.selected-page = 5; } }
                NavItem { label: "Logs"; selected: root.selected-page == 6; clicked => { root.selected-page = 6; } }
            }
        }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            Rectangle {
                background: root.status-text == "" ? #f6f8f7 : #eef6f3;
                border-color: root.status-text == "" ? #f6f8f7 : #cfe2dc;
                border-width: 1px;
                border-radius: 5px;
                height: 42px;

                Text {
                    text: root.status-text == "" ? "Ready" : root.status-text;
                    color: #50615c;
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                background: #fcfdfb;
                border-color: #dde6e1;
                border-width: 1px;
                border-radius: 5px;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 20px;
                    spacing: 11px;

                    if root.selected-page == 0: VerticalLayout {
                        spacing: 12px;
                        PageTitle { label: "General"; }
                        InfoLine { label: root.profile-line; }
                        InfoLine { label: root.recording-mode-line; }
                    }

                    if root.selected-page == 1: VerticalLayout {
                        spacing: 10px;
                        PageTitle { label: "Hotkeys"; }

                        Label { label: "Transcription"; }
                        Field { value <=> root.transcription-hotkey; }

                        Label { label: "Translation"; }
                        Field { value <=> root.translation-hotkey; }
                    }

                    if root.selected-page == 2: VerticalLayout {
                        spacing: 12px;
                        PageTitle { label: "Audio"; }
                    }

                    if root.selected-page == 3: VerticalLayout {
                        spacing: 10px;
                        PageTitle { label: "API"; }
                        InfoLine { label: root.profile-line; }

                        Label { label: "Base URL"; }
                        Field { value <=> root.api-base-url; }

                        Label { label: "Model"; }
                        Field { value <=> root.model-name; }

                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton { label: "Models"; fill: #cfddd6; clicked => { root.load-models(); } }
                            ActionButton { label: "Test"; fill: #cfddd6; clicked => { root.test-api-connection(); } }
                        }
                    }

                    if root.selected-page == 4: VerticalLayout {
                        spacing: 12px;
                        PageTitle { label: "Insertion"; }
                    }

                    if root.selected-page == 5: VerticalLayout {
                        spacing: 12px;
                        PageTitle { label: "Sounds"; }
                    }

                    if root.selected-page == 6: VerticalLayout {
                        spacing: 12px;
                        PageTitle { label: "Logs"; }
                        InfoLine { label: root.status-text == "" ? "No recent status message." : root.status-text; }

                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton { label: "Open"; fill: #cfddd6; clicked => { root.open-logs-folder(); } }
                            ActionButton { label: "Clear"; fill: #cfddd6; clicked => { root.clear-logs(); } }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                ActionButton { label: "Save"; fill: #51b3a2; clicked => { root.save(); } }
                ActionButton { label: "Close"; fill: #cfddd6; clicked => { root.close(); } }
            }
        }
    }
}
