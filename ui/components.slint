import { ComboBox } from "std-widgets.slint";

export component Label inherits Text {
    in property <string> label: "";

    text: label;
    color: #66746e;
    font-size: 13px;
    overflow: elide;
}

export component Field inherits Rectangle {
    in-out property <string> value: "";
    callback edited();

    height: 34px;
    background: #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    TextInput {
        text <=> root.value;
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        color: #1f2a28;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(); }
    }
}

export component SmallButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 104px;
    height: 34px;
    background: touch.pressed ? #d5e5df : touch.has-hover ? #edf5f2 : #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #1f2a28;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

export component TinyButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 34px;
    height: 34px;
    background: touch.pressed ? #d5e5df : touch.has-hover ? #edf5f2 : #ffffff;
    border-color: #c8d4ce;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.label;
        color: #1f2a28;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

export component ToggleRow inherits HorizontalLayout {
    in property <string> label: "";
    in-out property <bool> checked: false;
    callback toggled();

    height: 34px;
    horizontal-stretch: 1;
    spacing: 12px;

    Text {
        text: root.label;
        color: #66746e;
        font-size: 13px;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    Rectangle {
        width: 48px;
        height: 26px;
        background: root.checked ? #51b3a2 : #d7e1dc;
        border-radius: 6px;

        Rectangle {
            x: root.checked ? 24px : 4px;
            y: 4px;
            width: 18px;
            height: 18px;
            background: #ffffff;
            border-radius: 5px;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
}

export component HintLabel inherits Rectangle {
    in property <string> label: "";
    in property <string> hint: "";

    height: 34px;
    background: transparent;

    Label {
        label: root.label;
        x: 0;
        y: 0;
        width: root.hint != "" ? parent.width - 24px : parent.width;
        height: parent.height;
        vertical-alignment: center;
    }

    Rectangle {
        visible: root.hint != "";
        x: parent.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        background: hint-touch.has-hover ? #dbe7f5 : #eef3f8;
        border-color: #b8c7d8;
        border-width: 1px;
        border-radius: 8px;

        Text {
            text: "?";
            color: #516579;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        hint-touch := TouchArea { width: parent.width; height: parent.height; }
    }

    Rectangle {
        visible: root.hint != "" && hint-touch.has-hover;
        x: max(parent.width - self.width, 0px);
        y: -42px;
        width: 238px;
        height: 36px;
        background: #1f2a28;
        border-radius: 6px;

        Text {
            text: root.hint;
            x: 10px;
            y: 5px;
            width: parent.width - 20px;
            height: parent.height - 10px;
            color: #ffffff;
            font-size: 11px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

export component VerticalField inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> hint: "";
    in-out property <string> value: "";
    callback edited();

    spacing: 12px;
    height: 34px;

    HintLabel {
        label: root.label;
        hint: root.hint;
        width: 200px;
    }

    Field {
        value <=> root.value;
        horizontal-stretch: 1;
        edited => { root.edited(); }
    }
}

export component HotkeyCaptureField inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> capture-label: "";
    in property <string> capturing-label: "";
    in-out property <string> value: "";
    in-out property <bool> capturing: false;
    callback edited();
    callback capture-clicked();

    spacing: 12px;
    height: 34px;

    HintLabel {
        label: root.label;
        width: 200px;
    }

    Field {
        value <=> root.value;
        horizontal-stretch: 1;
        edited => { root.edited(); }
    }

    SmallButton {
        label: root.capturing ? root.capturing-label : root.capture-label;
        width: 82px;
        clicked => {
            root.capture-clicked();
        }
    }
}

export component VerticalCombo inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> hint: "";
    in-out property <string> value: "";
    in-out property <int> selected-index: 0;
    in property <[string]> options: [];
    callback selected(value: string);

    spacing: 12px;
    height: 34px;

    HintLabel {
        label: root.label;
        hint: root.hint;
        width: 200px;
    }

    Rectangle {
        height: 34px;
        horizontal-stretch: 1;
        background: #ffffff;
        border-color: #c8d4ce;
        border-width: 1px;
        border-radius: 6px;

        ComboBox {
            width: parent.width;
            height: parent.height;
            model: root.options;
            current-index <=> root.selected-index;
            horizontal-stretch: 1;
            selected(value) => {
                root.value = value;
                root.selected(value);
            }
        }

        Text {
            text: root.value;
            x: 12px;
            y: 0;
            width: parent.width - 44px;
            height: parent.height;
            color: #1f2a28;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: "v";
            x: parent.width - 28px;
            y: 0;
            width: 16px;
            height: parent.height;
            color: #66746e;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

