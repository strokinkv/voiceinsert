export component RecordingOverlay inherits Window {
    in-out property <string> status-text: "Recording";
    in-out property <float> level: 0;
    in-out property <bool> is-silent: false;

    width: 360px;
    height: 96px;
    always-on-top: true;
    background: transparent;

    Rectangle {
        background: #1f2a28cc;
        border-radius: 8px;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.status-text;
                color: #f8fbf9;
                font-size: 14px;
            }

            Rectangle {
                height: 28px;
                background: root.is-silent ? #66746e : #51b3a2;
                width: max(8px, root.level * 320px);
            }
        }
    }
}
