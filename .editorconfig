root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj,slnx,props,targets}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml,iss}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
